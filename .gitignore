# Base SQLite générée (régénérable via database/install.php)
database/*.sqlite
database/*.sqlite-wal
database/*.sqlite-shm

# Secrets locaux / serveur — NE JAMAIS versionner (évite l'écrasement FTP)
config/config.local.php

# Fichiers de session générés (on garde le dossier via .gitkeep)
storage/sessions/*
!storage/sessions/.gitkeep

# Dépendances / logs éventuels
node_modules/
*.log
.DS_Store

# Réglages locaux Claude Code
.claude/settings.local.json
