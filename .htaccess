# ============================================================
#  LastFit — .htaccess racine (filet de sécurité)
# ------------------------------------------------------------
#  Configuration normale : le document root du domaine pointe
#  sur public/ → ce fichier est au-dessus du docroot et IGNORÉ.
#
#  Si par erreur le domaine pointe sur la racine du projet,
#  ce fichier route quand même tout vers public/ et bloque
#  l'accès au code : le site reste fonctionnel et sécurisé.
# ============================================================

Options -Indexes
DirectoryIndex public/index.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloque l'accès web au code, à la config et aux données
    RewriteRule ^(app|config|database|storage|design)(/|$) - [F,L]

    # Sert les fichiers réels de public/ (assets, diag.php…)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^ public%{REQUEST_URI} [L]

    # Tout le reste passe par le front controller de public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^ public/index.php [QSA,L]
</IfModule>

# Repli si mod_rewrite est absent
RedirectMatch 403 ^/(app|config|database|storage|design)(/|$)
