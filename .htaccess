# ============================================================
#  LastFit — configuration Apache (racine)
# ============================================================

# URLs propres pour l'API : /api/slots -> /api/index.php/slots
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/(.*)$ api/index.php/$1 [QSA,L]
</IfModule>

# Page d'accueil
DirectoryIndex index.html

# Interdit l'accès direct aux dossiers sensibles (code, config, données)
RedirectMatch 403 ^/(src|config|database)(/|$)

# Désactive le listing de répertoires
Options -Indexes
